                <div className="flex items-center gap-2.5 text-[10px] font-mono">
                  <span className="text-[#D4FF00] font-bold">{catCalories} kcal</span>
                  <span className="text-blue-400 font-semibold">P:{catProtein.toFixed(1)}g</span>
