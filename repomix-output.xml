  useEffect(() => {
    if (skip) return;
    const t1 = setTimeout(() => setStage(1), 750);
    const t2 = setTimeout(() => setStage(2), 2200);
    const t3 = setTimeout(() => onFinish(), 3000);
    return () => {
      clearTimeout(t1);
      clearTimeout(t2);
