/* src/index.css */
@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    color-scheme: dark;
  }

  html {
    background-color: #050507;
    color: #F1F5F9;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
    overscroll-behavior: none;
  }

  body {
    background-color: #050507;
    background-image: 
      radial-gradient(circle at 50% 0%, rgba(212, 255, 0, 0.07) 0%, transparent 55%),
      radial-gradient(circle at 85% 90%, rgba(179, 71, 255, 0.03) 0%, transparent 45%),
      #050507;
    background-attachment: fixed;
    min-height: 100dvh;
    margin: 0;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    overflow-x: hidden;
  }

  #root {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    overscroll-behavior: none;
  }
}

/* ==========================================================================
   COMPONENTES Y UTILIDADES DE ULTRA-LUJO
   ========================================================================== */
@layer components {
  /* Tarjeta de cristal obsidiana con bisel especular */
  .luxury-card {
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.035) 0%, rgba(10, 10, 15, 0.8) 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: inset 0 1px 1px 0 rgba(255, 255, 255, 0.12), 0 16px 36px -12px rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-radius: 2rem;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .luxury-card-hover:hover {
    border-color: rgba(212, 255, 0, 0.3);
    box-shadow: inset 0 1px 1px 0 rgba(212, 255, 0, 0.25), 0 20px 40px -12px rgba(212, 255, 0, 0.15);
  }

  /* Insignia de telemetría de precisión */
  .luxury-badge {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 9px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
    background: rgba(212, 255, 0, 0.08);
    border: 1px solid rgba(212, 255, 0, 0.25);
    color: #D4FF00;
    box-shadow: 0 0 15px -3px rgba(212, 255, 0, 0.2);
  }

  /* Botón de acción principal neón */
  .volt-button {
    background: linear-gradient(135deg, #E5FF33 0%, #D4FF00 60%, #BFEA00 100%);
    color: #050507;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    box-shadow: inset 0 1px 1px 0 rgba(255, 255, 255, 0.6), 0 0 28px rgba(212, 255, 0, 0.35);
    border-radius: 1.25rem;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .volt-button:active {
    transform: scale(0.97);
    filter: brightness(0.95);
  }
}

/* Safe areas para PWA */
.safe-top { padding-top: env(safe-area-inset-top, 0px); }
.safe-bottom { padding-bottom: env(safe-area-inset-bottom, 0px); }
.safe-left { padding-left: env(safe-area-inset-left, 0px); }
.safe-right { padding-right: env(safe-area-inset-right, 0px); }

/* Scrollbars transparentes */
.no-scrollbar::-webkit-scrollbar,
.scrollbar-none::-webkit-scrollbar {
  display: none;
}
.no-scrollbar,
.scrollbar-none {
  -ms-overflow-style: none;
  scrollbar-width: none;
}

/* Animación de entrada fluida */
.animate-fade-in {
  animation: fadeIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes fadeIn {
  from { opacity: 0; transform: scale(0.98); }
  to { opacity: 1; transform: scale(1); }
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  20%, 60% { transform: translateX(-4px); }
  40%, 80% { transform: translateX(4px); }
}

.animate-shake {
  animation: shake 0.4s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
}
